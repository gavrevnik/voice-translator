# Codex SDK is the default translation provider and uses your local Codex login.
# Codex uses GPT-5.6 Luna with its lowest supported reasoning level (low).
# Optional. On macOS the ChatGPT app's current Codex CLI is detected automatically.
CODEX_CLI_PATH=

# Server-side Gemini key. Android also embeds it into local test builds.
GEMINI_API_KEY=your-gemini-api-key

# Used by Groq Whisper speech recognition on web and Android.
GROQ_API_KEY=your-groq-api-key

# Optional override for the downloadable Android OPUS model pack.
# Leave blank to use the GitHub Release URL from android/app/src/main/assets/offline_models.json.
OFFLINE_OPUS_MODEL_URL=

# Optional override for the downloadable Android Whisper Large V3 Turbo Q4_0 model.
# Leave blank to use the GitHub Release URL from android/app/src/main/assets/whisper_models.json.
OFFLINE_WHISPER_MODEL_URL=

PORT=8787
